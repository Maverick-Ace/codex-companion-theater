#!/usr/bin/env python3
"""Independent launcher; never replaces the installed codex or its config."""
import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time

ROOT=Path(__file__).resolve().parents[1]
def main():
    args=sys.argv[1:]
    if args and args[0]=='--preview':
        port=args[1] if len(args)>1 else '0'
        with tempfile.TemporaryDirectory(prefix='companion-preview-') as runtime:
            return subprocess.call([sys.executable,'-m','theater.cli','serve','--runtime',runtime,'--port',port],cwd=ROOT)
    manifest=Path(os.getenv('CODEX_THEATER_MANIFEST',str(ROOT/'build/current.json'))).expanduser().resolve()
    if not manifest.exists():
        sys.exit('Build the native adapter first: python3 scripts/build_cli.py --source /path/to/codex')
    binary=Path(json.loads(manifest.read_text())['binary'])
    if not binary.is_file():sys.exit(f'Native binary missing: {binary}')
    with tempfile.TemporaryDirectory(prefix='codex-theater-',dir=os.getenv('XDG_RUNTIME_DIR')) as runtime:
        runtime=str(Path(runtime).resolve())
        env=dict(os.environ,CODEX_THEATER_SOCKET=str(Path(runtime)/'control.sock'))
        env['PYTHONPATH']=str(ROOT)+os.pathsep+env.get('PYTHONPATH','')
        with open(Path(runtime)/'engine.log','w+') as log:
            engine=subprocess.Popen([sys.executable,'-m','theater.cli','serve','--runtime',runtime],cwd=ROOT,env=env,stdout=log,stderr=log,start_new_session=True)
            instance_path=None
            try:
                deadline=time.monotonic()+3
                while not Path(env['CODEX_THEATER_SOCKET']).exists():
                    if engine.poll() is not None or time.monotonic()>deadline:
                        log.seek(0);sys.exit('Theater startup failed: '+log.read())
                    time.sleep(.03)
                # A daemon-owned MCP process cannot inherit this foreground's env.
                # Publish only local control metadata; never conversation content.
                registry=Path.home()/'.cache/codex-companion-theater/instances'
                registry.mkdir(parents=True,exist_ok=True,mode=0o700)
                instance_path=registry/(Path(runtime).name+'.json')
                fd=os.open(instance_path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
                with os.fdopen(fd,'w') as record:
                    json.dump({'v':1,'id':Path(runtime).name,'socket':env['CODEX_THEATER_SOCKET'],'cwd':os.getcwd(),'pid':os.getpid()},record)
                # Native process receives Ctrl-C directly; the wrapper stays to clean up the sidecar.
                signal.signal(signal.SIGINT,lambda *_:None)
                # Extra -c overrides can force upstream into embedded mode and
                # disable shared-session navigation. The display bridge already
                # owns the native pet slot, so forward user arguments unchanged.
                cli=subprocess.Popen([str(binary),*args],env=env)
                return cli.wait()
            finally:
                if instance_path is not None:instance_path.unlink(missing_ok=True)
                engine.terminate()
                try:engine.wait(timeout=2)
                except subprocess.TimeoutExpired:engine.kill();engine.wait()

if __name__=='__main__':sys.exit(main())
